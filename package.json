{
  "name": "@colyseus/command",
  "version": "1.0.0",
  "description": "Command Pattern for Colyseus",
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "typings": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node build.mjs",
    "test": "tsc -p test && mocha",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colyseus/command.git"
  },
  "keywords": [
    "action",
    "dispatcher",
    "colyseus"
  ],
  "author": "Endel Dreyer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/colyseus/command/issues"
  },
  "homepage": "https://github.com/colyseus/command#readme",
  "devDependencies": {
    "@colyseus/schema": "^5.0.43",
    "@types/debug": "^4.1.5",
    "@types/mocha": "^10.0.10",
    "@types/nanoid": "^2.1.0",
    "@types/node": "^26.6.6",
    "colyseus": "^0.18.10",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.2",
    "mocha": "^12.0.3",
    "nanoid": "^2.1.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "colyseus": "*"
  },
  "dependencies": {
    "debug": "^4.1.1"
  }
}
