{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "build",
        "module": "preserve",
        "target": "es2022",
        "types": [],
        "declaration": true,
        "strict": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "noImplicitAny": false,
        "skipLibCheck": true
    },
    "include": [
      "src/**/*.ts"
    ]
}
